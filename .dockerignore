# Applies to builds whose context is the repository root (e.g. the API image,
# which bundles the corresponding source — see api/Dockerfile).
# Keeps the build context small and keeps build artifacts / dependencies out of
# the generated source bundle (recipients restore these with mvn / npm install).
.git
.github
.idea
**/node_modules
api/target
**/build
**/dist
**/.gradle
*.iml
api/src/main/resources/static/source
# A previous dev workflow left a gitignored copy of the compiled SPA here. On a
# developer machine that copy would be packaged BEFORE the fresh frontend build
# and could shadow it; CI never has it (fresh clone). Keep it out of the context.
api/src/main/resources/static/index.html
api/src/main/resources/static/asset-manifest.json
api/src/main/resources/static/static/js
api/src/main/resources/static/static/css
api/src/main/resources/static/static/media
atlas_backups
DEVELOPMENT-STATUS.md

# OpenTofu provider cache. Three copies of a 251 MB provider binary, which is
# how the "source" bundle reached 278 MB compressed and the jar 442 MB. Not
# source either way - `tofu init` fetches these.
**/.terraform
**/.terraform.tfstate*

# State and plans can carry resource detail; the plan file is a build artifact.
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# ⚠️ Every env file. These carry DB passwords, LICENSE_KEY and the Entra client
# secret, and the bundle built from this context is served PUBLICLY at
# GET /source-code/download for AGPLv3 §13. `dev.env` was reaching that zip.
# Configuration is not "corresponding source" - do not narrow this pattern.
.env
*.env
secrets-*.env
