src/main/resources/static/favicon.ico
src/main/resources/static/favicon-16x16.png
src/main/resources/static/favicon-32x32.png
src/main/resources/static/logo192.png
src/main/resources/static/logo512.png
src/main/resources/static/runtime-env.js
src/main/resources/static/.well-known/
src/main/resources/static/*.txt
