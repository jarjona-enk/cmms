# ──────────────────────────────────────────────────────────────────────────
# Production deployment settings. Read by azure-pipelines.yml.
#
# ⚠️ NOT the same file as the repo-root `prod.env`.
#
#   prod.env (repo root)   runtime config for running the app LOCALLY,
#                          including secrets. Gitignored, never committed,
#                          excluded from the Docker build context.
#
#   this file              the NON-SECRET values the pipeline needs: what to
#                          build the SPA with, which web app to deploy onto,
#                          and the application settings to push. Committed, so
#                          a change is a reviewable diff with history.
#
# **Never put a secret in here.** Secrets are set once on the web app by hand
# and the pipeline never touches them - see REQUIREMENTS.md §2.
#
# Infrastructure named below already exists and is NOT created by the pipeline.
# ──────────────────────────────────────────────────────────────────────────

# ── Deployment target ──
# The hand-built production web app and the image it runs.
WEBAPP_NAME=cmms
WEBAPP_RESOURCE_GROUP=New-Implementations
IMAGE_REPOSITORY=cmms

# ── Baked into the SPA bundle at image build time ──
# Create React App compiles these in, which is why the image is specific to
# this environment and can never be promoted from another one.
# PUBLIC_URL has no trailing slash.
PUBLIC_URL=https://cmms.enerkem.com
ENABLE_SSO=true
OAUTH2_PROVIDER=microsoft

# ── Application settings pushed onto the web app ──
# Non-secret only. Anything not listed here is left untouched on the app,
# which is how the secrets below survive a deploy.

# Web App for Containers needs to know the listening port or it probes the
# wrong one and every request 504s.
WEBSITES_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# host:port/database only - application.yml prepends jdbc:postgresql://.
# The private-endpoint IP of db-caneast-pmdms, not its FQDN: the FQDN resolves
# to the server's public address, which refuses connections. See §4.
DB_URL=10.225.1.104:5432/atlas
DB_USER=atlas

# Azure Blob storage backend. The account and container already exist.
STORAGE_TYPE=azure
AZURE_STORAGE_ACCOUNT=stgcaneastcmms
AZURE_STORAGE_CONTAINER=atlas-files
# Leave AZURE_STORAGE_ENDPOINT unset to use
# https://<account>.blob.core.windows.net. Only override it for a hostname that
# genuinely fronts the account - SAS signatures are host-bound.

# Entra SSO. Client id and tenant id are public identifiers, not secrets.
OAUTH2_CLIENT_ID=635e54c9-ea8e-46a6-844b-13c4a530ec67
OAUTH2_TENANT_ID=cddc5ffd-9378-428d-bdb9-f54efe98769c

# Mail. Off until SMTP is verified end to end; MAIL_RECIPIENTS is required even
# then, because application.yml gives it no default.
MAIL_RECIPIENTS=cmms-admins@enerkem.com
ENABLE_EMAIL_NOTIFICATIONS=false
INVITATION_VIA_EMAIL=false

# One jar serves the API and the SPA, so there is a single origin.
ENABLE_CORS=false

# Where api/container/startup.sh tees the console output, for reading over SSH
# (az webapp ssh --name cmms --resource-group New-Implementations).
LOG_FILE=/home/cmms/atlas.log
